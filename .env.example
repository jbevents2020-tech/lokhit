# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Gemini configuration (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Server-only WordPress REST API configuration
WORDPRESS_URL=https://your-wordpress-site.example
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

